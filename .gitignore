node_modules/
data/
server/public/

# Secrets never belong in the repo (scripts/check-secrets.mjs guards commits).
# The hub keeps every credential in a file under data/ (already ignored:
# api-token, delegate.key, attention.json keyFiles, swarm-keys/); these cover
# a key file or env file landing anywhere else.
*.key
*.pem
*.p8
.env
.env.*
swarm-keys/

.stfolder/
.stignore
version.json
data/pusher.json
data/pushed-sessions.json
hub-env.cmd

# Obsidian's own workspace settings, when docs/architect is opened as a vault
.obsidian/

# Architect documentation: kept in the folder, never committed (docs/architect-convention.md)
docs/architect/
