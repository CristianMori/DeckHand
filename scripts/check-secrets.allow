# Known false positives for scripts/check-secrets.mjs — one JavaScript regex
# per line, tested against "<kind> <file> <match>". Keep every entry narrow and
# say why it is safe.

# The fleet's own notification mailbox: a deliberate, public sender address
# (README, docs/automation-api.md, and the email tests quote it).
email-address .* raven@mori\.guru$

# Test fixture addresses in the email alert tests.
email-address server/email\.test\.ts c@x\.io$

# The discovery documentation quotes sample UDP beacon replies and the
# directed-broadcast address: 192.168.1.0/24 addresses are private-range,
# unroutable, and the default subnet of most home routers.
private-ip (README\.md|docs/automation-api\.md) 192\.168\.1\.\d+$
